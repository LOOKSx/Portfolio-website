{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "dist/kruaon-portfolio-frontend/browser",
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
